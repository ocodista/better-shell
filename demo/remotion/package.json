{
  "name": "better-shell-remotion-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion project that renders the before/after README demo GIFs.",
  "scripts": {
    "studio": "remotion studio",
    "render:before": "remotion render Before ../before-remotion.gif --codec=gif",
    "render:after": "remotion render After ../after-remotion.gif --codec=gif"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "typescript": "^5.5.0"
  }
}
