{
  "name": "better-shell",
  "version": "1.0.0",
  "description": "Interactive terminal setup manager with zsh, Oh My Zsh, fzf, mise, tmux, and more",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "bin": {
    "better-shell": "./dist/better-shell"
  },
  "engines": {
    "bun": ">=1.3.1"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun run build.ts",
    "build:all": "bun run build.ts --all",
    "deploy:prod": "wrangler deploy --env production",
    "test": "bun test",
    "test:unit": "bun test",
    "test:interactive": "./tests/test-all.sh",
    "test:quick": "./tests/quick-test.sh",
    "test:ubuntu": "./tests/test-ubuntu.sh",
    "test:alpine": "./tests/test-alpine.sh",
    "test:ubuntu:dev": "./tests/test-ubuntu-interactive.sh",
    "test:alpine:dev": "./tests/test-alpine-interactive.sh",
    "test:integration:prepare": "bun run build:all && ./tests/prepare-binaries.sh",
    "test:integration": "bun run test:integration:prepare && bun run tests/integration/test-ubuntu.ts && bun run tests/integration/test-alpine.ts",
    "test:integration:ubuntu": "bun run test:integration:prepare && bun run tests/integration/test-ubuntu.ts",
    "test:integration:alpine": "bun run test:integration:prepare && bun run tests/integration/test-alpine.ts",
    "check": "bun run src/index.ts check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "wrangler": "^4.46.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "keywords": [
    "terminal",
    "shell",
    "zsh",
    "oh-my-zsh",
    "fzf",
    "mise",
    "tmux",
    "tui",
    "cli",
    "developer-tools",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "picocolors": "^1.1.1"
  }
}
